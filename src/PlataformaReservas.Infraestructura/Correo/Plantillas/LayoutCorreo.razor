<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@Titulo</title>
</head>
<body style="margin:0;padding:24px;background:#f4f4f4;font-family:Arial,Helvetica,sans-serif;color:#222;">
    <div style="max-width:560px;margin:0 auto;padding:24px;background:#fff;border-radius:6px;">
        <h1 style="margin-top:0;font-size:20px;">@Titulo</h1>
        @ChildContent
        <p data-pie style="margin-top:32px;font-size:12px;color:#777;">Plataforma de Reservas. Este correo se ha enviado automáticamente; no lo respondas.</p>
    </div>
</body>
</html>

@code {
    [Parameter, EditorRequired]
    public string Titulo { get; set; } = "";

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
