@using PlataformaReservas.Infraestructura.Identidad

<div class="nav-enlaces">
    <AuthorizeView>
        <Authorized>
            <AuthorizeView Policy="@RolesIdentidad.PoliticaPropietario" Context="propietario">
                <NavLink href="app">Mi establecimiento</NavLink>
            </AuthorizeView>
            <AuthorizeView Policy="@RolesIdentidad.PoliticaCliente" Context="cliente">
                <NavLink href="my-account/bookings">Mis reservas</NavLink>
                <NavLink href="my-account/profile">Mi perfil</NavLink>
            </AuthorizeView>
            <form action="Account/Logout" method="post">
                <AntiforgeryToken />
                <input type="hidden" name="ReturnUrl" value="" />
                <button type="submit" class="salir">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9" />
                    </svg>
                    Cerrar sesión
                </button>
            </form>
        </Authorized>
        <NotAuthorized>
            <NavLink href="login">Iniciar sesión</NavLink>
            <NavLink href="register">Registrarse</NavLink>
            <NavLink href="for-business/register" class="nav-destacado">Registrar mi negocio</NavLink>
        </NotAuthorized>
    </AuthorizeView>
</div>
