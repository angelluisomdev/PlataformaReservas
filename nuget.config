<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Un unico origen: con gestion centralizada de paquetes y TreatWarningsAsErrors,
       varios origenes heredados de la maquina provocan NU1507. Tambien hace la
       restauracion reproducible en CI y Docker. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
