{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(dotnet build)",
      "Bash(dotnet build *)",
      "Bash(dotnet test)",
      "Bash(dotnet test *)",
      "Bash(dotnet restore)",
      "Bash(dotnet restore *)",
      "Bash(dotnet new *)",
      "Bash(dotnet sln *)",
      "Bash(dotnet add *)",
      "Bash(dotnet ef migrations *)",
      "Bash(dotnet list package *)",
      "Bash(dotnet --info)",
      "Bash(dotnet --version)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)"
    ],
    "ask": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(dotnet ef database *)",
      "Bash(docker *)"
    ],
    "deny": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)",
      "Bash(rm -rf *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/appsettings.*.local.json)",
      "Read(./**/secrets.json)",
      "Read(./**/*.pfx)",
      "Read(./**/*.key)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/compilar.sh\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
